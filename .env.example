# ARC — configuration
#
# Every configurable runtime value in the project appears in this file. Nothing
# configurable is hardcoded anywhere else; if a value is not here, it is not
# configurable by design.
#
# PRECEDENCE, highest wins:
#
#   1. CLI arguments              `arc run --mode=v2` beats ARC_MODE below
#   2. SQLite operator settings   the Settings page, for TRADING values only
#   3. .env                       this file
#   4. Built-in defaults          infrastructure only, never a trading value
#
# The split at rung 2 is the reason there are two groups below:
#
#   TRADING values (windows, buffers, sizing, quota, entry band, cancel lead,
#   thresholds, retention) are read from this file ONCE, on the very first
#   startup, to seed the settings table. From then on the Settings page is the
#   source of truth and editing this file changes nothing — an operator who
#   changed a buffer in the UI must not have it reverted by a stale .env.
#
#   INFRASTRUCTURE values (endpoints, credentials, bind address, log level,
#   provider, presentation) are read from this file on EVERY startup and are not
#   editable from the dashboard. A credential reachable from a web form is a
#   credential that can be replaced from a web form.
#
# Every value in the trading section marked "EXAMPLE" is a placeholder for the
# file format only. It is not a recommendation and was not calibrated against
# anything. There are no defaults in code for trading values: a missing or
# invalid one is a fatal startup error, never a silently-substituted guess.
#
# Infrastructure values SHOWN COMMENTED OUT are already the built-in default and
# do not need to be set. They are listed so the complete surface is visible.

# ═════════════════════════════════════════════════════════════════════════════
# RUNTIME                                            infrastructure — every boot
# ═════════════════════════════════════════════════════════════════════════════

# V1 (paper) or V2 (live). These are the only two values that exist.
ARC_MODE=V1

# Must be a loopback address. A non-loopback bind is refused at startup — ARC has
# no authentication and the loopback bind is what protects the dashboard. Remote
# access is by SSH tunnel:  ssh -L 8080:localhost:8080 user@vps
ARC_API_BIND=127.0.0.1
ARC_API_PORT=8080

ARC_DB_PATH=data/arc.db
ARC_LOG_DIR=logs

# DEBUG, INFO, WARNING or ERROR. An unknown level is a startup error rather than
# a silent fall back to INFO: an operator who set DEBUG to chase a fault and
# received INFO would conclude the fault produced no logging.
ARC_LOG_LEVEL=INFO

# IANA zone name for log timestamps, e.g. Europe/London. Blank uses the host's
# own zone. Set it when the VPS and the operator are in different regions, so the
# log lines line up with the Polymarket page without arithmetic during an
# incident. An unknown name is refused at startup.
ARC_TIMEZONE=

# Descriptive only: the name to look for in `pm2 list`. ARC never spawns or
# signals PM2; it only reports whether PM2 spawned it.
ARC_PM2_NAME=arc

# ═════════════════════════════════════════════════════════════════════════════
# PROVIDERS                                          infrastructure — every boot
# ═════════════════════════════════════════════════════════════════════════════
#
# Where the running TWAP's price data comes from. Switching providers is a
# configuration change only — no strategy behaviour moves, and no component
# downstream of the feed learns which provider is live.
#
# RTDS is the default and the only implemented provider; it needs no credentials.
# CHAINLINK is configuration-ready and REFUSED AT STARTUP until an official feed
# ID, official credentials and official documentation have been verified. The
# keys below exist so there is somewhere to put them and are deliberately blank.
# Do not invent a feed ID — a guessed identifier produces prices that look
# exactly like real ones.
#
# There is no automatic switching and no mixed-provider operation: one provider
# supplies all TWAP data or none of it.

ARC_TWAP_PROVIDER=RTDS

# The RTDS relay. Defaults to the address the official SDK ships.
# ARC_RTDS_URL=wss://ws-live-data.polymarket.com

ARC_CHAINLINK_API_KEY=
ARC_CHAINLINK_API_SECRET=
# ARC_CHAINLINK_FEBS_ID is accepted as an alias for this variable; set either one.
ARC_CHAINLINK_FEED_ID=

# ═════════════════════════════════════════════════════════════════════════════
# POLYMARKET CREDENTIALS                             infrastructure — every boot
# ═════════════════════════════════════════════════════════════════════════════
#
# Required only when MODE=V2. Never logged, never stored in the database, never
# printed. `arc doctor` reports SET or UNSET and nothing else.

ARC_POLYMARKET_API_KEY=
ARC_POLYMARKET_API_SECRET=
ARC_POLYMARKET_API_PASSPHRASE=
ARC_POLYMARKET_PRIVATE_KEY=

# The proxy wallet orders are signed for, when it differs from the address the
# private key derives. Blank lets the official SDK derive it, which is the
# documented default and correct for most setups.
ARC_POLYMARKET_PROXY_ADDRESS=

# The account whose collateral funds the orders. The official SDK signs and funds
# from a SINGLE address, so this must either match the proxy address or be blank;
# two different values are refused at startup rather than one being dropped.
ARC_POLYMARKET_FUNDER=

# ═════════════════════════════════════════════════════════════════════════════
# CLOB ENDPOINTS                                     infrastructure — every boot
# ═════════════════════════════════════════════════════════════════════════════
#
# All three default to the official SDK's production environment. Set them only
# to point at a different deployment; a hand-copied hostname is one that silently
# stops matching the SDK the day Polymarket moves it.

# ARC_CLOB_HOST=https://clob.polymarket.com
# ARC_CLOB_HTTP_URL=https://clob.polymarket.com
# ARC_CLOB_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/user

# ═════════════════════════════════════════════════════════════════════════════
# WALLET                                             infrastructure — every boot
# ═════════════════════════════════════════════════════════════════════════════

# Optional cross-check. When set, startup refuses if the configured private key
# controls a different address — the dashboard would otherwise report balances
# for an account ARC cannot trade from. ARC never derives the address itself; the
# official SDK owns that derivation.
ARC_WALLET_ADDRESS=

# Both default to the official SDK's production environment (production / 137).
# ARC_NETWORK_ID=production
# ARC_CHAIN_ID=137

# ═════════════════════════════════════════════════════════════════════════════
# TELEGRAM                                           infrastructure — every boot
# ═════════════════════════════════════════════════════════════════════════════
#
# NOTIFICATION ONLY. Nothing here can start, stop, arm, disarm, submit, cancel or
# configure anything, and there is no inbound path at all. The bot token is
# deliberately NOT editable from the dashboard: a bot token reachable from a web
# form is a bot token that can be replaced from a web form. The twenty-one
# per-category toggles ARE editable there and persist in SQLite.

# Master switch, separate from the per-category toggles, so silencing ARC for a
# maintenance window does not mean remembering which categories were off.
ARC_TELEGRAM_ENABLED=true
ARC_TELEGRAM_BOT_TOKEN=
ARC_TELEGRAM_CHAT_ID=

# Forum topic id, for a chat organised into threads. Leave blank for an ordinary
# chat — Telegram rejects a thread id on a non-forum chat and every notification
# would silently fail.
ARC_TELEGRAM_THREAD_ID=

# ═════════════════════════════════════════════════════════════════════════════
# RECOVERY                                           infrastructure — every boot
# ═════════════════════════════════════════════════════════════════════════════

# First reconnect delay and the ceiling the exponential ladder grows to. The
# ceiling is what stops a long outage from stretching the retry interval past the
# length of a market, which would mean waking up already too late for the next
# one. The maximum must not be below the initial delay.
ARC_RECONNECT_BACKOFF_MS=500
ARC_RECONNECT_BACKOFF_MAX_MS=30000

# ═════════════════════════════════════════════════════════════════════════════
# DASHBOARD PRESENTATION                             infrastructure — every boot
# ═════════════════════════════════════════════════════════════════════════════

# How often the browser repaints from the state it already holds. NOT a poll
# interval — the dashboard never polls, the socket pushes.
ARC_REFRESH_RATE_MS=250

# dark or light. Named rather than free text so a typo is a startup error instead
# of a dashboard that renders unstyled and looks broken.
ARC_THEME=dark

# ═════════════════════════════════════════════════════════════════════════════
# TRADING                                    seeds SQLite ONCE, then the UI wins
# ═════════════════════════════════════════════════════════════════════════════

# EXECUTION WINDOWS — seconds before close. Priority is always 3 → 5 → 7 → 10 → 15.
ARC_EXECUTION_WINDOWS=15,10,7,5,3

# BUFFERS — one per window, "offset:buffer". A window with no buffer, or a buffer
# with no window, is a fatal error rather than a window that silently never fires.
# EXAMPLE VALUES — REPLACE. Remember the inertia multiplier (A7): on the 3s window
# a buffer of 1.00 requires a $100 BTC move; on the 15s window, $20.
ARC_BUFFERS=15:2.00,10:2.00,7:1.50,5:1.25,3:1.00

# ── sizing and quota — EXAMPLE VALUES — REPLACE ──────────────────────────────
ARC_POSITION_NOTIONAL_USD=25.00
ARC_MAX_TRADES_PER_MARKET=3
# Open positions across the WHOLE process, not per market. Two markets overlap at
# every boundary, so a per-market cap alone permits twice the intended exposure.
ARC_MAX_CONCURRENT_POSITIONS=3

# ── loss limits — 0 disables each one. EXAMPLE VALUES — REPLACE ──────────────
# Two separate numbers because they fail differently: one large loss and a run of
# small ones are different signals. Breaching either denies new intents.
ARC_MAX_DAILY_LOSS_USD=50.00
ARC_MAX_CONSECUTIVE_LOSSES=5

# ── entry band — EXAMPLE VALUES — REPLACE ────────────────────────────────────
# Prices are floored to TICK_SIZE before validation, never after (defect D2).
ARC_ENTRY_PRICE_MIN=0.55
ARC_ENTRY_PRICE_MAX=0.85
ARC_TICK_SIZE=0.01
# Exchange minimum tradable quantity, in shares. Quota decrements only once
# cumulative fills across a window's whole reprice chain reach this (hazard H4).
ARC_MIN_TRADABLE_SIZE=5

# How many independent passive limit orders one approved exposure is DIVIDED
# into, per window. 1 = one order for the whole approved size. Higher values
# split that same size N ways; they never multiply it. The splits sum exactly to
# the approved size, and N is reduced deterministically if a split would fall
# below ARC_MIN_TRADABLE_SIZE.
ARC_SUBMISSION_COUNT=1

# ── cancellation sweep ───────────────────────────────────────────────────────
# Begins this many ms before close. Kept small so the late windows stay tradeable;
# must be smaller than the earliest window offset or that window would open already
# inside the sweep and could never trade.
ARC_CANCEL_LEAD_MS=500
ARC_CANCEL_ACK_TIMEOUT_MS=1000

# ── feed health — warn threshold must be below critical ──────────────────────
ARC_FEED_STALE_WARN_MS=3000
ARC_FEED_STALE_CRITICAL_MS=10000

# ── clock drift — measured against the venue clock. warn below critical ──────
# Thresholds apply to the absolute offset: -900ms is as bad as +900ms.
ARC_CLOCK_DRIFT_WARN_MS=250
ARC_CLOCK_DRIFT_CRITICAL_MS=1000

# ── outbound rate limit toward Polymarket ────────────────────────────────────
# Cancels bypass this bucket entirely. Burst must be at least the sustained rate.
ARC_OUTBOUND_RATE_SUSTAINED=8
ARC_OUTBOUND_RATE_BURST=16

# ── hazard H3 ────────────────────────────────────────────────────────────────
# Holding UP and DOWN in one market costs more than it can return. Leave false
# unless you have a specific reason.
ARC_ALLOW_OPPOSING_DIRECTIONS=false

# ── retention ────────────────────────────────────────────────────────────────
# Raw observations older than this are pruned. ~86k rows/day. Also sets how many
# rotated log files are kept.
ARC_OBSERVATION_RETENTION_DAYS=90
