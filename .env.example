# ARC — bootstrap configuration
#
# This file is read ONCE, on the very first startup, to seed the settings table in
# SQLite. From that point on the Settings page is the source of truth and every
# startup loads the saved configuration from the database. Editing this file after
# the first run changes nothing.
#
# Keep in here: credentials, paths, bind address, retention.
# Edit in the Settings page: buffers, sizing, quota, entry band, cancel lead.
#
# EVERY VALUE BELOW MARKED "EXAMPLE" IS A PLACEHOLDER NUMBER FOR THE FILE FORMAT ONLY.
# It is not a recommendation and was not calibrated against anything. Replace each one
# with your own value before running. There are no defaults in code: a missing or
# invalid trading value is a fatal startup error, never a silently-substituted guess.

# ─────────────────────────────────────────────────────────────────────────────
# MODE — V1 (paper) or V2 (live). These are the only two values that exist.
# ─────────────────────────────────────────────────────────────────────────────
ARC_MODE=V1

# ─────────────────────────────────────────────────────────────────────────────
# DASHBOARD
# Must be a loopback address. A non-loopback bind is refused at startup — remote
# access is by SSH tunnel:  ssh -L 8080:localhost:8080 user@vps
# ─────────────────────────────────────────────────────────────────────────────
ARC_API_BIND=127.0.0.1
ARC_API_PORT=8080

# ─────────────────────────────────────────────────────────────────────────────
# STORAGE
# ─────────────────────────────────────────────────────────────────────────────
ARC_DB_PATH=data/arc.db
ARC_LOG_DIR=logs
# Raw Chainlink observations older than this are pruned. ~86k rows/day.
ARC_OBSERVATION_RETENTION_DAYS=90

# ─────────────────────────────────────────────────────────────────────────────
# EXECUTION WINDOWS — seconds before close. Priority is always 3 → 5 → 7 → 10 → 15.
# ─────────────────────────────────────────────────────────────────────────────
ARC_EXECUTION_WINDOWS=15,10,7,5,3

# BUFFERS — one per window, "offset:buffer". A window with no buffer, or a buffer
# with no window, is a fatal error rather than a window that silently never fires.
# EXAMPLE VALUES — REPLACE. Remember the inertia multiplier (A7): on the 3s window
# a buffer of 1.00 requires a $100 BTC move; on the 15s window, $20.
ARC_BUFFERS=15:2.00,10:2.00,7:1.50,5:1.25,3:1.00

# ─────────────────────────────────────────────────────────────────────────────
# SIZING AND QUOTA — EXAMPLE VALUES — REPLACE
# ─────────────────────────────────────────────────────────────────────────────
ARC_POSITION_NOTIONAL_USD=25.00
ARC_MAX_TRADES_PER_MARKET=3
# Open positions across the WHOLE process, not per market. Two markets overlap at
# every boundary, so a per-market cap alone permits twice the intended exposure.
ARC_MAX_CONCURRENT_POSITIONS=3

# ─────────────────────────────────────────────────────────────────────────────
# LOSS LIMITS — 0 disables each one. EXAMPLE VALUES — REPLACE.
# Two separate numbers because they fail differently: one large loss and a run of
# small ones are different signals. Breaching either denies new intents.
# ─────────────────────────────────────────────────────────────────────────────
ARC_MAX_DAILY_LOSS_USD=50.00
ARC_MAX_CONSECUTIVE_LOSSES=5

# ─────────────────────────────────────────────────────────────────────────────
# ENTRY BAND — EXAMPLE VALUES — REPLACE
# Prices are floored to TICK_SIZE before validation, never after (defect D2).
# ─────────────────────────────────────────────────────────────────────────────
ARC_ENTRY_PRICE_MIN=0.55
ARC_ENTRY_PRICE_MAX=0.85
ARC_TICK_SIZE=0.01
# Exchange minimum tradable quantity, in shares. Quota decrements only once
# cumulative fills across a window's whole reprice chain reach this (hazard H4).
ARC_MIN_TRADABLE_SIZE=5

# ─────────────────────────────────────────────────────────────────────────────
# CANCELLATION SWEEP
# Begins this many ms before close. Kept small so the late windows stay tradeable;
# must be smaller than the earliest window offset or that window would open already
# inside the sweep and could never trade.
# ─────────────────────────────────────────────────────────────────────────────
ARC_CANCEL_LEAD_MS=500
ARC_CANCEL_ACK_TIMEOUT_MS=1000

# ─────────────────────────────────────────────────────────────────────────────
# FEED HEALTH — warn threshold must be below critical.
# ─────────────────────────────────────────────────────────────────────────────
ARC_FEED_STALE_WARN_MS=3000
ARC_FEED_STALE_CRITICAL_MS=10000

# ─────────────────────────────────────────────────────────────────────────────
# CLOCK DRIFT — measured against the venue clock. warn below critical.
# Thresholds apply to the absolute offset: -900ms is as bad as +900ms.
# ─────────────────────────────────────────────────────────────────────────────
ARC_CLOCK_DRIFT_WARN_MS=250
ARC_CLOCK_DRIFT_CRITICAL_MS=1000

# ─────────────────────────────────────────────────────────────────────────────
# OUTBOUND RATE LIMIT toward Polymarket. Cancels bypass this bucket entirely.
# Burst must be at least the sustained rate.
# ─────────────────────────────────────────────────────────────────────────────
ARC_OUTBOUND_RATE_SUSTAINED=8
ARC_OUTBOUND_RATE_BURST=16

# ─────────────────────────────────────────────────────────────────────────────
# HAZARD H3 — holding UP and DOWN in one market costs more than it can return.
# Leave false unless you have a specific reason.
# ─────────────────────────────────────────────────────────────────────────────
ARC_ALLOW_OPPOSING_DIRECTIONS=false

# ─────────────────────────────────────────────────────────────────────────────
# CREDENTIALS — required only when MODE=V2. Never logged, never stored in the
# database, never printed. `arc doctor` reports SET or UNSET and nothing else.
# ─────────────────────────────────────────────────────────────────────────────
ARC_POLYMARKET_API_KEY=
ARC_POLYMARKET_API_SECRET=
ARC_POLYMARKET_API_PASSPHRASE=
ARC_POLYMARKET_PRIVATE_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# TWAP PROVIDER — where the running TWAP's price data comes from.
# RTDS is the only implemented provider and needs no credentials. CHAINLINK is
# configuration-ready and refused at startup until an official feed ID, official
# credentials and official documentation have been verified; the keys below exist
# so there is somewhere to put them, and are deliberately blank. Do not invent a
# feed ID — a guessed identifier produces prices that look exactly like real ones.
# Switching providers is a configuration change only; no strategy behaviour moves.
# ─────────────────────────────────────────────────────────────────────────────
ARC_TWAP_PROVIDER=RTDS

ARC_CHAINLINK_API_KEY=
ARC_CHAINLINK_API_SECRET=
ARC_CHAINLINK_FEED_ID=
