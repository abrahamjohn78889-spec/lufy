# ARC — VPS Live Market Validation Configuration
# PART 3 Baseline: MAJORITY ON, BUFFER OFF, TRIGGER+TARGET OFF, PRICE RETRY OFF
# PAPER EXECUTION (V1), REAL DATA ALL ON

ARC_MODE=V1
ARC_API_BIND=127.0.0.1
ARC_API_PORT=8080
ARC_DB_PATH=data/arc.db
ARC_LOG_DIR=logs
ARC_OBSERVATION_RETENTION_DAYS=90

# Execution windows for baseline validation (6 windows × 3 trades = 18)
ARC_EXECUTION_WINDOWS=150,120,45,35,25,15

# Buffers matching each window (required by config validation even when buffer is OFF)
ARC_BUFFERS=150:2.00,120:2.00,45:1.50,35:1.25,25:1.00,15:1.00

# Sizing
ARC_POSITION_NOTIONAL_USD=25.00
ARC_MAX_TRADES_PER_MARKET=3

# Entry band
ARC_ENTRY_PRICE_MIN=0.55
ARC_ENTRY_PRICE_MAX=0.85
ARC_TICK_SIZE=0.01
ARC_MIN_TRADABLE_SIZE=5

# Cancellation sweep
ARC_CANCEL_LEAD_MS=500
ARC_CANCEL_ACK_TIMEOUT_MS=1000

# Feed health
ARC_FEED_STALE_WARN_MS=3000
ARC_FEED_STALE_CRITICAL_MS=10000

# Clock drift
ARC_CLOCK_DRIFT_WARN_MS=250
ARC_CLOCK_DRIFT_CRITICAL_MS=1000

# Rate limit
ARC_OUTBOUND_RATE_SUSTAINED=8
ARC_OUTBOUND_RATE_BURST=16

# Safety
ARC_ALLOW_OPPOSING_DIRECTIONS=false

# Credentials (empty for V1 paper)
ARC_POLYMARKET_API_KEY=
ARC_POLYMARKET_API_SECRET=
ARC_POLYMARKET_API_PASSPHRASE=
ARC_POLYMARKET_PRIVATE_KEY=

# Post-Phase 5 keys
ARC_MAX_CONCURRENT_POSITIONS=3
ARC_MAX_DAILY_LOSS_USD=50.00
ARC_MAX_CONSECUTIVE_LOSSES=5
ARC_SUBMISSION_COUNT=1
ARC_TWAP_PROVIDER=RTDS
ARC_CHAINLINK_API_KEY=
ARC_CHAINLINK_API_SECRET=
ARC_CHAINLINK_FEED_ID=
